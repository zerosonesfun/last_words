<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="src" />
          <add segment="lib" />
          <add segment="migrations" />
          <add segment="resources" />
          <add segment="data" />
          <add segment="tests" />
          <add segment="docs" />
          <add segment="client" />
          <add segment="examples" />
          <add segment="dist" />
          <add segment="data_path.php" />
          <add segment="config.example.php" />
          <add segment="release.sh" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".sh" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
